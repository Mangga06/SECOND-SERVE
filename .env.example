# Load with uvicorn --env-file .env (install python-dotenv), or export these variables.
DATA_DIR=data
# Leave DATABASE_URL unset for DATA_DIR/secondserve.db. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://secondserve:password@localhost/secondserve
# Generate a unique 48-byte secret. Local dev generates data/.session-secret automatically.
# SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
APP_URL=http://localhost:5173
# Optional locally trained segmentation model. Do not point to untrusted pickle checkpoints.
# YOLO_MODEL_PATH=models/food-segmentation.pt
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=secondserve@example.com
